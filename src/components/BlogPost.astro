---
import FormattedDate from "../components/FormattedDate.astro";
import type { HeaderVideo } from "../lib/ghost";

interface Props {
  pubDate: Date | string;
  title?: string | null;
  featureImage?: string | null;
  featureImageAlt?: string | null;
  headerVideo?: HeaderVideo | null;
}

const { pubDate, title, featureImage, featureImageAlt, headerVideo } = Astro.props;
---

<style>
  .post-title {
    font-size: 1.15em;
    margin: 0 0 0.3em;
    line-height: 1.25;
  }
  .date {
    margin-bottom: 1em;
    color: rgb(var(--gray));
  }
  .feature-image {
    width: 100%;
    height: auto;
    border-radius: 8px;
    margin-bottom: 1.25rem;
    display: block;
  }
  .header-video {
    margin: 0 0 1.25rem;
  }
  .header-video video,
  .header-video img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    background: rgb(var(--surface-elevated));
  }
  .header-video img {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .header-video:has(img) video {
      display: none;
    }
    .header-video img {
      display: block;
    }
  }
</style>
<article>
  <div class="prose">
    {headerVideo ? (
      <figure class="header-video">
        <video
          src={headerVideo.src}
          poster={headerVideo.poster ?? undefined}
          width={headerVideo.width ?? undefined}
          height={headerVideo.height ?? undefined}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-label={title ?? undefined}
        />
        {headerVideo.poster && <img src={headerVideo.poster} alt={title ?? ""} />}
      </figure>
    ) : featureImage && (
      <img class="feature-image" src={featureImage} alt={featureImageAlt ?? ""} loading="lazy" />
    )}
    {title && <h2 class="post-title">{title}</h2>}
    <div class="date">
      <FormattedDate date={new Date(pubDate)} locale="sv" />
    </div>
    <slot />
  </div>
</article>
