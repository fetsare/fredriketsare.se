---
import FormattedDate from "../components/FormattedDate.astro";

interface Props {
  pubDate: Date | string;
  title?: string | null;
  featureImage?: string | null;
  featureImageAlt?: string | null;
}

const { pubDate, title, featureImage, featureImageAlt } = Astro.props;
---

<style>
  .post-title {
    font-size: 1.15em;
    margin: 0 0 0.3em;
    line-height: 1.25;
  }
  .date {
    margin-bottom: 1em;
    color: rgb(var(--gray));
  }
  .feature-image {
    width: 100%;
    height: auto;
    border-radius: 8px;
    margin-bottom: 1.25rem;
    display: block;
  }
</style>
<article>
  <div class="prose">
    {featureImage && (
      <img class="feature-image" src={featureImage} alt={featureImageAlt ?? ""} loading="lazy" />
    )}
    {title && <h2 class="post-title">{title}</h2>}
    <div class="date">
      <FormattedDate date={new Date(pubDate)} locale="sv" />
    </div>
    <slot />
  </div>
</article>
