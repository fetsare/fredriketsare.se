---
import HeaderLink from "./HeaderLink.astro";
import { NAV_LINKS } from "../consts";

type NavLink = {
  href: string;
  label: string;
};

interface Props {
  links?: readonly NavLink[];
  ariaLabel?: string;
}

const {
  links = NAV_LINKS,
  ariaLabel = "Main navigation",
} = Astro.props as Props;
---

<nav class="navbar" aria-label={ariaLabel}>
  <div class="navbar-inner">
    {
      links.map((link, index) => (
        <>
          <HeaderLink href={link.href}>{link.label}</HeaderLink>
          {index < links.length - 1 && <span class="separator" aria-hidden="true">,</span>}
        </>
      ))
    }
  </div>
</nav>

<style>
  .navbar {
    border-bottom: 0;
    background: var(--page-bg);
  }

  .navbar-inner {
    width: 720px;
    max-width: calc(100% - 2em);
    margin: 0 auto;
    padding: 0.7em 0;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0;
    color: rgb(var(--text-muted));
    font-size: 1em;
  }

  .navbar-inner :global(a) {
    color: rgb(var(--text-muted));
    text-decoration: none;
  }

  .navbar-inner :global(a:hover),
  .navbar-inner :global(a.active),
  .navbar-inner :global(a[aria-current="page"]) {
    color: white;
    text-decoration: underline;
  }

  .separator {
    margin: 0 0.4rem;
    color: rgb(var(--text-muted));
    opacity: 0.75;
  }
</style>
