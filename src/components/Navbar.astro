---
import HeaderLink from "./HeaderLink.astro";
import { NAV_LINKS } from "../consts";
---

<nav class="navbar" aria-label="Main navigation">
  <div class="navbar-inner">
    {
      NAV_LINKS.map((link, index) => (
        <>
          <HeaderLink href={link.href}>{link.label}</HeaderLink>
          {index < NAV_LINKS.length - 1 && <span class="separator" aria-hidden="true">,</span>}
        </>
      ))
    }
  </div>
</nav>

<style>
  .navbar {
    border-top: 1px solid rgb(var(--surface-divider));
    border-bottom: 0;
    background: var(--page-bg);
  }

  .navbar-inner {
    width: 720px;
    max-width: calc(100% - 2em);
    margin: 0 auto;
    padding: 0.7em 0;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0;
    color: rgb(var(--text-muted));
    font-size: 1em;
  }

  .navbar-inner :global(a) {
    color: rgb(var(--text-muted));
    text-decoration: none;
  }

  .navbar-inner :global(a:hover),
  .navbar-inner :global(a.active) {
    color: rgb(var(--text-primary));
    text-decoration: none;
  }

  .separator {
    margin: 0 0.4rem;
    color: rgb(var(--text-muted));
    opacity: 0.75;
  }
</style>
