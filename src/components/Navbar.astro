---
import HeaderLink from "./HeaderLink.astro";
import { getMainNavLinks, type SiteLocale } from "../i18n";

type NavLink = {
  href: string;
  label: string;
  icon: string;
};

interface Props {
  links?: readonly NavLink[];
  ariaLabel?: string;
  locale?: SiteLocale;
}

const {
  locale = "sv",
  links = getMainNavLinks(locale),
  ariaLabel = "Main navigation",
} = Astro.props as Props;

const ICONS: Record<string, string> = {
  home: '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline>',
  projects:
    '<rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>',
  about:
    '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle>',
  books:
    '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>',
  images:
    '<rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline>',
};
---

<nav class="navbar" aria-label={ariaLabel}>
  <ul class="navbar-inner">
    {
      links.map((link) => (
        <li class="navbar-item">
          <HeaderLink class="nav-link" href={link.href}>
            <svg
              class="nav-icon"
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={ICONS[link.icon]}
            />
            <span class="nav-label">{link.label}</span>
          </HeaderLink>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .navbar {
    border-bottom: 0;
    background: var(--page-bg);
  }

  .navbar-inner {
    box-sizing: border-box;
    width: 720px;
    max-width: calc(100% - 2em);
    margin: 0 auto;
    padding: 1rem 0 0.5rem;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 0.2rem;
    font-size: 0.8em;
  }

  .navbar-item {
    display: flex;
  }

  .navbar-inner :global(a.nav-link) {
    display: flex;
    align-items: center;
    gap: 0.3em;
    padding: 0.25em 0.55em;
    border-radius: 9999px;
    color: rgb(var(--text-muted));
    text-decoration: none;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .navbar-inner :global(.nav-icon) {
    flex-shrink: 0;
  }

  .navbar-inner :global(a.nav-link:hover) {
    background: rgb(var(--surface-elevated));
    color: rgb(var(--text-primary));
  }

  .navbar-inner :global(a.nav-link.active) {
    background: var(--accent);
    color: #fff;
  }

  @media (max-width: 720px) {
    .navbar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 40;
      border-top: 1px solid rgb(var(--surface-divider));
      padding-bottom: env(safe-area-inset-bottom);
    }

    .navbar-inner {
      width: 100%;
      max-width: 100%;
      padding: 0.4em 0.5em;
      justify-content: space-around;
      gap: 0.15rem;
    }

    .navbar-item {
      flex: 1;
    }

    .navbar-inner :global(a.nav-link) {
      flex-direction: column;
      justify-content: center;
      gap: 0.15em;
      width: 100%;
      min-height: 44px;
      padding: 0;
      border-radius: 12px;
    }

    .navbar-inner :global(.nav-label) {
      display: none;
    }

    .navbar-inner :global(.nav-icon) {
      width: 20px;
      height: 20px;
    }
  }
</style>
