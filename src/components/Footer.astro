---
const today = new Date();
---

<footer>
  <div class="footer-inner">
    <div class="internal-links" aria-label="Footer navigation">
      <a href="/">Blog</a>
      <span class="separator" aria-hidden="true">~</span>
      <a href="/projekt">Mina Projekt</a>
      <!-- <span class="separator" aria-hidden="true">~</span>
      <a href="/about">Om</a> -->
    </div>

    <div class="social-links">
      <a
        class="cv"
        href="/CV-Fredrik-Etsare.pdf"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="sr-only">Open my CV (PDF)</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
          ></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <path d="M9 15h6"></path>
          <path d="M9 19h6"></path>
          <path d="M9 11h1"></path>
        </svg>
      </a>

      <a class="mail" href="mailto:fredrik@etsare.se">
        <span class="sr-only">Email me</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"></path>
          <rect x="2" y="4" width="20" height="16" rx="2"></rect>
        </svg>
      </a>

      <a
        class="linkedin"
        href="https://www.linkedin.com/in/fredrik-etsare-20a535255/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="sr-only">Go to my LinkedIn</span>
        <svg viewBox="0 0 24 24" aria-hidden="true" width="24" height="24">
          <path
            fill="currentColor"
            d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.05-1.86-3.05-1.86 0-2.14 1.45-2.14 2.95v5.67H9.33V9h3.42v1.56h.05c.48-.9 1.64-1.86 3.37-1.86 3.61 0 4.28 2.38 4.28 5.47v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77A1.77 1.77 0 0 0 0 1.77v20.46C0 23.21.79 24 1.77 24h20.46A1.77 1.77 0 0 0 24 22.23V1.77A1.77 1.77 0 0 0 22.23 0z"
          ></path>
        </svg>
      </a>

      <a
        class="github"
        href="https://github.com/fetsare"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="sr-only">Go to my github</span>
        <svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
          ><path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
          ></path></svg
        >
      </a>
    </div>

    <p class="copyright">&copy; {today.getFullYear()} Fredrik Etsare. All rights reserved.</p>
  </div>
</footer>
<style>
  footer {
    margin-top: 2rem;
    border-top: 1px solid rgb(var(--surface-divider));
    background: var(--page-bg);
  }

  .footer-inner {
    width: 720px;
    max-width: calc(100% - 2em);
    margin: 0 auto;
    padding: 1rem 0 1.35rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
  }

  .internal-links {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 1rem;
  }

  .internal-links a {
    color: rgb(var(--text-muted));
    text-decoration: none;
  }

  .internal-links a:hover {
    color: rgb(var(--text-primary));
  }

  .separator {
    color: rgb(var(--text-muted));
    opacity: 0.75;
  }

  .social-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
  }

  .social-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    text-decoration: none;
    color: rgb(var(--text-primary));
  }

  .social-links a svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .social-links a svg[fill="none"] {
    stroke-width: 2.1;
  }

  .social-links a.linkedin svg,
  .social-links a.github svg {
    width: 19px;
    height: 19px;
  }

  .copyright {
    margin: 0;
    font-size: 0.95rem;
    color: rgb(var(--text-muted));
    text-align: center;
  }
</style>
