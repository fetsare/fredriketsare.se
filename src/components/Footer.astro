---
import SocialLinks from "./SocialLinks.astro";
import { getMainNavLinks, type SiteLocale } from "../i18n";

const today = new Date();
const locale: SiteLocale = Astro.props.locale ?? "sv";
const navLinks = getMainNavLinks(locale);
const copyrightText =
  locale === "en"
    ? `© ${today.getFullYear()} Fredrik Etsare.`
    : `© ${today.getFullYear()} Fredrik Etsare.`;
---

<footer>
  <div class="footer-inner">
    <div
      class="internal-links"
      aria-label={locale === "en" ? "Footer navigation" : "Sidfotsnavigering"}
    >
      {
        navLinks.map((link) => {
          const isExternal = link.href.startsWith("http");
          return (
            <a
              href={link.href}
              target={isExternal ? "_blank" : undefined}
              rel={isExternal ? "noopener noreferrer" : undefined}
            >
              {link.label}
            </a>
          );
        })
      }
    </div>

    <div class="social-links">
      <SocialLinks locale={locale} />
    </div>

    <p class="copyright">{copyrightText}</p>
  </div>
</footer>
<style>
  footer {
    margin-top: 2rem;
    border-top: 1px solid rgb(var(--surface-divider));
    background: var(--page-bg);
  }

  .footer-inner {
    width: 720px;
    max-width: calc(100% - 2em);
    margin: 0 auto;
    padding: 1rem 0 1.35rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
  }

  .internal-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.3rem 1rem;
    font-size: 1rem;
  }

  .internal-links a {
    color: rgb(var(--text-muted));
    text-decoration: none;
  }

  .internal-links a:hover {
    color: rgb(var(--text-primary));
    text-decoration: underline;
  }

  .social-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
  }

  .copyright {
    margin: 0;
    font-size: 0.95rem;
    color: rgb(var(--text-muted));
    text-align: center;
  }
</style>
