---
interface Props {
  images: string[];
  href: string;
  label?: string;
}

const { images, href, label = 'Se alla bilder' } = Astro.props;
---

<div class="photo-gallery">
  <div class="photo-grid">
    {images.map((src) => (
      <a href={href} target="_blank" rel="noopener noreferrer" class="photo-cell">
        <img src={src} alt="" loading="lazy" decoding="async" />
      </a>
    ))}
  </div>
  <a href={href} target="_blank" rel="noopener noreferrer" class="see-more">
    {label} →
  </a>
</div>

<style>
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3px;
  }

  .photo-cell {
    aspect-ratio: 1;
    overflow: hidden;
    display: block;
  }

  .photo-cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    display: block;
    transition: opacity 0.15s;
  }

  .photo-cell:hover img {
    opacity: 0.85;
  }

  .see-more {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.85em;
    color: rgb(var(--gray));
    text-decoration: none;
  }

  .see-more:hover {
    color: rgb(var(--text-primary));
    text-decoration: underline;
  }
</style>
