---
interface Props {
  date: Date;
  locale?: "sv" | "en";
}

const { date, locale = "sv" } = Astro.props;
const dateLocale = locale === "en" ? "en-US" : "sv-SE";
---

<time datetime={date.toISOString()}>
  {
    date.toLocaleDateString(dateLocale, {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  }
</time>
