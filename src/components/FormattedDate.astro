---
interface Props {
  date: Date;
  locale?: "sv" | "en";
}

const { date, locale = "sv" } = Astro.props;
const dateLocale = locale === "en" ? "en-US" : "sv-SE";

const now = new Date();
const diffMs = now.getTime() - date.getTime();
const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
const diffMonths = Math.floor(diffDays / 30);
const diffYears = Math.floor(diffDays / 365);

const rtf = new Intl.RelativeTimeFormat(dateLocale, { numeric: "auto" });
let timeAgo: string;
if (diffYears >= 1) {
  timeAgo = rtf.format(-diffYears, "year");
} else if (diffMonths >= 1) {
  timeAgo = rtf.format(-diffMonths, "month");
} else if (diffDays >= 1) {
  timeAgo = rtf.format(-diffDays, "day");
} else {
  timeAgo = locale === "en" ? "today" : "idag";
}
timeAgo = timeAgo.replace(/^för\s/, "");
---

<time datetime={date.toISOString()}>
  {
    date.toLocaleDateString(dateLocale, {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  }
  <span style="color: rgb(var(--text-muted)); font-size: 0.85em; margin-left: 0.4em;">({timeAgo})</span>
</time>
