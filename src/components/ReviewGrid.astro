---
interface ReviewItem {
  name: string;
  image: string;
  link?: string;
}

interface Props {
  items: ReviewItem[];
  emptyText?: string;
}

const { items, emptyText = "Inga bilder ännu." } = Astro.props;
---

{
  items.length > 0 ? (
    <div class="image-grid-2x2">
      {
        items.map((item) => (
          <figure>
            <a
              class="review-image-link"
              href={item.link ?? item.image}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Open ${item.name}`}
            >
              <img src={item.image} alt={item.name} loading="lazy" />
            </a>
            <figcaption>
              {item.link ? (
                <a class="review-name" href={item.link} target="_blank" rel="noopener noreferrer">
                  {item.name}
                </a>
              ) : (
                <span class="review-name">{item.name}</span>
              )}
            </figcaption>
          </figure>
        ))
      }
    </div>
  ) : (
    <p class="empty-state">{emptyText}</p>
  )
}

<style>
  .review-image-link {
    display: block;
  }

  .review-name {
    display: inline-block;
  }

  .empty-state {
    margin-top: 0.5rem;
    color: rgb(var(--text-muted));
  }
</style>
