---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

const { href, class: className, ...props } = Astro.props;

const normalizePath = (value: string) => {
  const input = value || "/";
  const hasScheme = /^[a-zA-Z][a-zA-Z\d+.-]*:/.test(input);
  let pathname = input;

  if (hasScheme) {
    try {
      pathname = new URL(input).pathname || "/";
    } catch {
      pathname = "/";
    }
  } else {
    pathname = input.split(/[?#]/)[0] || "/";
  }

  const baseUrl = import.meta.env.BASE_URL;
  const normalizedBase = baseUrl === "/" ? "" : baseUrl.replace(/\/$/, "");

  if (normalizedBase && pathname.startsWith(normalizedBase)) {
    pathname = pathname.slice(normalizedBase.length) || "/";
  }

  if (!pathname.startsWith("/")) {
    pathname = `/${pathname}`;
  }

  if (pathname.length > 1 && pathname.endsWith("/")) {
    return pathname.slice(0, -1);
  }

  return pathname;
};

const pathname = normalizePath(Astro.url.pathname);
const normalizedHref = normalizePath(String(href || ""));
const isActive =
  normalizedHref === pathname ||
  (normalizedHref !== "/" && pathname.startsWith(`${normalizedHref}/`));
---

<a
  href={href}
  aria-current={isActive ? "page" : undefined}
  class:list={[className, { active: isActive }]}
  {...props}
  
  ><slot /></a
>
<style>
  a {
    display: inline-block;
    text-decoration: none;
  }
</style>
