---
import AvatarImage from "../assets/fredrik.webp";
import HeaderLink from "./HeaderLink.astro";
import { getMainNavLinks, type SiteLocale } from "../i18n";

type NavLink = {
  href: string;
  label: string;
  icon: string;
};

const locale: SiteLocale = Astro.props.locale ?? "sv";
const homePath = locale === "en" ? "/en" : "/";
const navLinks = getMainNavLinks(locale) as readonly NavLink[];
const menuLabel = locale === "en" ? "Menu" : "Meny";
const navAriaLabel = locale === "en" ? "Main navigation" : "Huvudnavigering";
---

<header>
  <div class="header-inner">
    <h2>
      <a href={homePath}>
        <img
          class="avatar"
          src={AvatarImage.src}
          alt="Fredrik Etsare"
          width="36"
          height="36"
        />
        <span>fredriketsare.se</span>
      </a>
    </h2>

    <div class="nav-menu">
      <button
        type="button"
        class="nav-menu-trigger"
        aria-haspopup="true"
        aria-expanded="false"
      >
        <span>{menuLabel}</span>
        <svg
          class="nav-menu-chevron"
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>

      <nav class="nav-menu-panel" aria-label={navAriaLabel}>
        <ul>
          {
            navLinks.map((link) => {
              const isExternal = link.href.startsWith("http");
              return (
                <li>
                  <HeaderLink
                    class="nav-menu-link"
                    href={link.href}
                    target={isExternal ? "_blank" : undefined}
                    rel={isExternal ? "noopener noreferrer" : undefined}
                  >
                    {link.label}
                  </HeaderLink>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  header {
    margin: 0;
    padding: 0.75rem 0;
    background: var(--page-bg);
    border-bottom: 1px solid rgb(var(--surface-divider));
  }

  .header-inner {
    width: 720px;
    max-width: calc(100% - 2em);
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  h2 {
    margin: 0;
    font-size: 0.92em;
    line-height: 1;
  }

  h2 a {
    display: flex;
    align-items: center;
    height: 2rem;
    gap: 0.5rem;
    color: rgb(var(--text-primary));
    text-decoration: none;
  }

  .avatar {
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    margin-right: 0.5em;
    object-fit: cover;
    display: block;
  }

  .nav-menu {
    position: relative;
  }

  .nav-menu-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.4em 0.75em;
    border-radius: 9999px;
    border: none;
    background: none;
    color: rgb(var(--text-primary));
    font-family: inherit;
    font-size: 0.85em;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .nav-menu-trigger:hover,
  .nav-menu:hover .nav-menu-trigger,
  .nav-menu.open .nav-menu-trigger {
    background: rgb(var(--surface-elevated));
  }

  .nav-menu-chevron {
    transition: transform 0.2s ease;
  }

  .nav-menu:hover .nav-menu-chevron,
  .nav-menu.open .nav-menu-chevron {
    transform: rotate(180deg);
  }

  .nav-menu-panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    min-width: 160px;
    background: var(--page-bg);
    border: 1px solid rgb(var(--surface-divider));
    border-radius: 10px;
    padding: 0.3rem;
    z-index: 50;
    display: none;
  }

  .nav-menu-panel::before {
    content: "";
    position: absolute;
    top: -0.5rem;
    left: 0;
    right: 0;
    height: 0.5rem;
  }

  .nav-menu:hover .nav-menu-panel,
  .nav-menu.open .nav-menu-panel {
    display: block;
  }

  .nav-menu-panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-menu-panel li + li {
    border-top: 1px solid rgba(var(--surface-divider), 0.6);
  }

  .nav-menu-panel :global(a.nav-menu-link) {
    display: block;
    padding: 0.6em 0.7em;
    border-radius: 6px;
    color: rgb(var(--text-muted));
    font-size: 0.85em;
    text-decoration: none;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .nav-menu-panel :global(a.nav-menu-link:hover) {
    background: rgb(var(--surface-elevated));
    color: rgb(var(--text-primary));
  }

  .nav-menu-panel :global(a.nav-menu-link.active) {
    color: rgb(var(--gray));
    font-weight: 700;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".nav-menu").forEach((menu) => {
    const trigger = menu.querySelector<HTMLButtonElement>(".nav-menu-trigger");
    if (!trigger) return;

    const closeMenu = () => {
      menu.classList.remove("open");
      trigger.setAttribute("aria-expanded", "false");
    };

    const openMenu = () => {
      menu.classList.add("open");
      trigger.setAttribute("aria-expanded", "true");
    };

    trigger.addEventListener("click", (event) => {
      event.stopPropagation();
      if (menu.classList.contains("open")) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    document.addEventListener("click", (event) => {
      if (menu.classList.contains("open") && !menu.contains(event.target as Node)) {
        closeMenu();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.classList.contains("open")) {
        closeMenu();
        trigger.focus();
      }
    });
  });
</script>
