---
import type { ImageMetadata } from "astro";
import { SITE_TITLE } from "../consts";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { getAllPosts } from "../lib/ghost";

interface Props {
  title?: string;
  description: string;
  image?: ImageMetadata;
  canonicalPath?: string;
  metaType?: "website" | "article";
  publishedTime?: string;
  wide?: boolean;
}

const {
  title = SITE_TITLE,
  description,
  image,
  canonicalPath,
  metaType,
  publishedTime,
  wide = false,
} = Astro.props;
const currentPath = canonicalPath ?? Astro.url.pathname;

const allPosts = await getAllPosts('sv');
const featuredLinks = allPosts
  .filter((post) => post.featured)
  .map((post) => ({
    title: post.title,
    href: `/featured/${post.slug}`,
  }));

const hasBooksColumn = Astro.slots.has("books-column");
---

<!doctype html>
<html lang="sv">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      canonicalPath={currentPath}
      metaType={metaType}
      publishedTime={publishedTime}
    />
  </head>
  <body>
    <Header />
    <main
      class:list={[
        "site-main",
        { "site-main--two-col": hasBooksColumn, "site-main--wide": wide },
      ]}
    >
      <div class="layout-shell">
        {featuredLinks.length > 0 && (
          <aside class="featured-sidebar" data-featured-sidebar aria-label="Featured sidebar">
            <h2>Utvalda inlägg</h2>
            <ul>
              {featuredLinks.map((featuredPost) => (
                <li><a href={featuredPost.href}>{featuredPost.title}</a></li>
              ))}
            </ul>
          </aside>
        )}

        <div class="layout-content">
          <slot />
        </div>

        {hasBooksColumn && (
          <aside class="books-column" aria-label="Senaste böckerna">
            <slot name="books-column" />
          </aside>
        )}
      </div>
    </main>
    <Footer />
  </body>
</html>

<style>
  .layout-shell {
    position: relative;
  }

  .layout-content {
    min-width: 0;
  }

  .site-main--two-col {
    width: auto;
    max-width: calc(100% - 2em);
  }

  .site-main--wide {
    width: 1100px;
    max-width: calc(100% - 2em);
  }

  .site-main--two-col .layout-shell {
    display: flex;
    align-items: flex-start;
    gap: 2.5rem;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto;
  }

  .site-main--two-col .layout-content {
    width: 720px;
    max-width: 100%;
    flex: 0 0 auto;
  }

  .books-column {
    flex: 0 0 auto;
    max-width: 280px;
    min-width: 0;
  }

  @media (max-width: 720px) {
    .site-main--two-col .layout-shell {
      flex-direction: column;
      gap: 0;
      width: 100%;
    }

    .site-main--two-col .layout-content,
    .books-column {
      width: 100%;
      max-width: 100%;
    }

    .books-column {
      margin-top: 1rem;
    }
  }

  .featured-sidebar {
    position: fixed;
    top: var(--featured-sidebar-top, 0px);
    left: calc(var(--featured-sidebar-blog-left, 50%) - 3rem - 220px);
    width: 220px;
    text-align: right;
    background: var(--page-bg);
  }

  .featured-sidebar ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .featured-sidebar h2 {
    margin: 0 0 0.45rem;
    font-size: 0.72rem;
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgb(var(--text-muted));
  }

  .featured-sidebar li + li {
    margin-top: 0.45rem;
  }

  .featured-sidebar::after {
    content: "";
    position: absolute;
    right: -0.95rem;
    top: 0;
    width: 1px;
    height: 100%;
    background: rgb(var(--surface-divider));
  }

  @media (max-width: 900px) {
    .featured-sidebar {
      display: none;
    }
  }
</style>

<script is:inline>
  function updateFeaturedSidebarPosition() {
    const contentShell = document.querySelector(".layout-shell");
    const blogColumn = contentShell?.querySelector(".layout-content");
    if (!contentShell || !blogColumn) {
      return;
    }

    const shellTop = contentShell.getBoundingClientRect().top;
    const blogLeft = blogColumn.getBoundingClientRect().left;

    document.documentElement.style.setProperty(
      "--featured-sidebar-top",
      `${Math.max(0, shellTop)}px`,
    );
    document.documentElement.style.setProperty(
      "--featured-sidebar-blog-left",
      `${Math.max(0, blogLeft)}px`,
    );
  }

  window.addEventListener("load", updateFeaturedSidebarPosition);
  window.addEventListener("resize", updateFeaturedSidebarPosition);
</script>
