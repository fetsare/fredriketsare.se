---
import type { ImageMetadata } from "astro";
import { getCollection } from "astro:content";
import { SITE_DESCRIPTION, SITE_DESCRIPTION_EN, SITE_TITLE } from "../consts";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Navbar from "../components/Navbar.astro";
import { getLocaleFromPathname, getLocalizedPath, type SiteLocale } from "../i18n";
import {
  getUniqueSlug,
  isFeatured,
  resolveFeaturedSeo,
} from "../utils/featuredSeo";

interface Props {
  title?: string;
  description: string;
  image?: ImageMetadata;
  locale?: SiteLocale;
  canonicalPath?: string;
  metaType?: "website" | "article";
  publishedTime?: string;
}

const {
  title = SITE_TITLE,
  description,
  image,
  locale: propLocale,
  canonicalPath,
  metaType,
  publishedTime,
} = Astro.props;
const locale = propLocale ?? getLocaleFromPathname(Astro.url.pathname);
const currentPath = canonicalPath ?? Astro.url.pathname;

const alternateUrls = {
  sv: new URL(getLocalizedPath(currentPath, "sv"), Astro.site),
  en: new URL(getLocalizedPath(currentPath, "en"), Astro.site),
};

const featuredSourcePosts =
  locale === "en" ? await getCollection("blogEn") : await getCollection("blog");
const featuredFallbackDescription =
  locale === "en" ? SITE_DESCRIPTION_EN : SITE_DESCRIPTION;
const featuredTitle = locale === "en" ? "Featured posts" : "Utvalda inlagg";
const featuredPathPrefix = locale === "en" ? "/en/featured/" : "/featured/";
const usedFeaturedSlugs = new Set<string>();

const featuredLinks = featuredSourcePosts
  .filter((post) => !post.data.draft && isFeatured(post.data.featured))
  .map((post) => {
    const seo = resolveFeaturedSeo({
      title: post.data.title,
      body: post.body,
      featured: post.data.featured,
      siteTitle: SITE_TITLE,
      fallbackDescription: featuredFallbackDescription,
    });

    return {
      title: post.data.title,
      href: `${featuredPathPrefix}${getUniqueSlug(seo.slug, usedFeaturedSlugs)}`,
    };
  });
---

<!doctype html>
<html lang={locale}>
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      locale={locale}
      alternateUrls={alternateUrls}
      canonicalPath={currentPath}
      metaType={metaType}
      publishedTime={publishedTime}
    />
  </head>
  <body>
    <Header locale={locale} />
    <Navbar locale={locale} />
    <main>
      <div class="layout-shell">
        {featuredLinks.length > 0 && (
          <aside class="featured-sidebar" data-featured-sidebar aria-label="Featured sidebar">
            <h2>{featuredTitle}</h2>
            <ul>
              {featuredLinks.map((featuredPost) => (
                <li><a href={featuredPost.href}>{featuredPost.title}</a></li>
              ))}
            </ul>
          </aside>
        )}

        <div class="layout-content">
          <slot />
        </div>
      </div>
    </main>
    <Footer locale={locale} />
  </body>
</html>

<style>
  .layout-shell {
    position: relative;
  }

  .layout-content {
    min-width: 0;
  }

  .featured-sidebar {
    position: fixed;
    top: var(--featured-sidebar-top, 0px);
    left: calc(50% - 360px - 3rem - 220px);
    width: 220px;
    text-align: right;
    background: var(--page-bg);
  }

  .featured-sidebar ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .featured-sidebar h2 {
    margin: 0 0 0.45rem;
    font-size: 0.72rem;
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgb(var(--text-muted));
  }

  .featured-sidebar li + li {
    margin-top: 0.45rem;
  }

  .featured-sidebar::after {
    content: "";
    position: absolute;
    right: -0.95rem;
    top: 0;
    width: 1px;
    height: 100%;
    background: rgb(var(--surface-divider));
  }

  @media (max-width: 900px) {
    .featured-sidebar {
      display: none;
    }
  }
</style>

<script is:inline>
  function updateFeaturedSidebarTop() {
    const contentShell = document.querySelector(".layout-shell");
    if (!contentShell) {
      return;
    }

    const shellTop = contentShell.getBoundingClientRect().top;
    document.documentElement.style.setProperty(
      "--featured-sidebar-top",
      `${Math.max(0, shellTop)}px`,
    );
  }

  window.addEventListener("load", updateFeaturedSidebarTop);
  window.addEventListener("resize", updateFeaturedSidebarTop);
</script>
