---
import type { GetStaticPaths } from "astro";
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ReviewGrid from "../../../components/ReviewGrid.astro";
import Navbar from "../../../components/Navbar.astro";
import { getReviewNavLinks } from "../../../i18n";

export const getStaticPaths: GetStaticPaths = async () => {
  const pages = await getCollection("reviews");
  return pages.map((page) => ({
    params: {
      slug: page.id === "kyrkor" ? "churches" : page.id === "ol" ? "beer" : page.id,
    },
  }));
};

const slugParam = Astro.params.slug;

if (!slugParam) {
  throw new Error("Missing image category slug.");
}

const slug = slugParam;
const sourceSlug = slug === "churches" ? "kyrkor" : slug === "beer" ? "ol" : slug;

const entry = await getEntry("reviews", sourceSlug);

if (!entry) {
  throw new Error(`Missing image category entry: reviews/${sourceSlug}.md`);
}

const { Content } = await render(entry);
---

<BaseLayout
  description={entry.data.description ?? `Images: ${entry.data.title}`}
  locale="en"
  canonicalPath={`/en/images/${slug}`}
>
  <div class="review-subnav">
    <Navbar links={getReviewNavLinks("en")} locale="en" ariaLabel="Images navigation" />
  </div>
  <section class="prose">
    <Content />
  </section>

  <ReviewGrid items={entry.data.items} emptyText={`No images in ${entry.data.title} yet.`} />
</BaseLayout>

<style>
  .review-subnav {
    margin-top: -0.7rem;
    margin-bottom: 0.6rem;
  }

  .review-subnav :global(.navbar-inner) {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding-top: 0.35rem;
    padding-bottom: 0.35rem;
  }
</style>
