---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getGalleryImages } from "../../utils/gallery";

const images = await getGalleryImages();
---

<BaseLayout description="Photos I have taken." locale="en">
  <div class="gallery-page">
    <h1>Images</h1>
    {
      images.length > 0 ? (
        <div class="masonry">
          {images.map((image) => (
            <figure>
              <a href={image.src} target="_blank" rel="noopener noreferrer">
                <img
                  src={image.src}
                  width={image.width}
                  height={image.height}
                  alt={image.alt}
                  loading="lazy"
                  decoding="async"
                />
              </a>
            </figure>
          ))}
        </div>
      ) : (
        <p class="empty-state">No images yet.</p>
      )
    }
  </div>
</BaseLayout>

<style is:global>
  main:has(.gallery-page) {
    width: 100%;
    max-width: 1600px;
    padding: 1em 2em;
  }

  @media (min-width: 721px) {
    body:has(.gallery-page) .navbar-inner {
      width: 100%;
      max-width: 1600px;
      padding-left: 2em;
      padding-right: 2em;
    }
  }

  body:has(.gallery-page) .featured-sidebar {
    display: none;
  }

  @media (max-width: 720px) {
    main:has(.gallery-page) {
      padding: 1em;
    }
  }
</style>

<style>
  .gallery-page h1 {
    margin-bottom: 1rem;
  }

  .empty-state {
    color: rgb(var(--text-muted));
  }

  .masonry {
    column-count: 4;
    column-gap: 1rem;
  }

  .masonry figure {
    margin: 0 0 1rem;
    break-inside: avoid;
  }

  .masonry img {
    display: block;
    width: 100%;
    border-radius: 8px;
  }

  @media (max-width: 1200px) {
    .masonry {
      column-count: 3;
    }
  }

  @media (max-width: 900px) {
    .masonry {
      column-count: 2;
    }
  }

  @media (max-width: 520px) {
    .masonry {
      column-count: 1;
    }
  }
</style>
