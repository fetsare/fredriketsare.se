---
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BookRows from "../../components/BookRows.astro";

const entry = await getEntry("books", "books");

if (!entry) {
  throw new Error("Missing books entry: books/books.md");
}
---

<BaseLayout description="Books I think you should read." locale="en">
  <section class="prose">
    <p>Here are some books I have read and think you should read.</p>
  </section>

  <BookRows items={entry.data.items} locale="en" />
</BaseLayout>

<style>
  .prose :global(:first-child) {
    margin-top: 0;
  }

  .prose :global(:last-child) {
    margin-bottom: 0;
  }
</style>
