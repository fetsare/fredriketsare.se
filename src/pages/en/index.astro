---
import { SITE_DESCRIPTION_EN } from "../../consts";
import BlogPost from "../../components/BlogPost.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BooksColumnList from "../../components/BooksColumnList.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { getEntry } from "astro:content";
import { getAllPosts } from "../../lib/ghost";

const RECENT_BOOKS_COUNT = 30;
const posts = await getAllPosts('en');
const fullPosts = posts.slice(0, 2);
const previewPosts = posts.slice(2, 12);

const booksEntry = await getEntry("books", "books");
const recentBooks = booksEntry ? booksEntry.data.items.slice(-RECENT_BOOKS_COUNT).reverse() : [];
---

<BaseLayout description={SITE_DESCRIPTION_EN} locale="en">
  {
    fullPosts.map((post, index) => (
      <>
        <BlogPost
          pubDate={post.published_at}
          title={post.title}
          featureImage={post.feature_image}
          featureImageAlt={post.feature_image_alt}
        >
          <Fragment set:html={post.html} />
        </BlogPost>
        {index < fullPosts.length - 1 && <hr class="blog-divider" />}
      </>
    ))
  }

  {
    previewPosts.length > 0 && (
      <>
        <hr class="blog-divider" />
        <ul class="post-cards">
          {previewPosts.map((post) => (
            <li>
              <a
                href={post.url}
                class="post-card"
                target="_blank"
                rel="noopener noreferrer"
              >
                <div class="post-card-body">
                  <span class="post-card-title">{post.title}</span>
                  <span class="post-card-date">
                    <FormattedDate date={new Date(post.published_at)} locale="en" />
                  </span>
                  {post.custom_excerpt && (
                    <p class="post-card-excerpt">{post.custom_excerpt}</p>
                  )}
                </div>
                <span class="post-card-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </>
    )
  }

  {
    recentBooks.length > 0 && (
      <Fragment slot="books-column">
        <BooksColumnList items={recentBooks} locale="en" seeAllHref="/en/books" />
      </Fragment>
    )
  }
</BaseLayout>

<style>
  .blog-divider {
    border-top-color: rgb(var(--surface-divider));
    margin: 4rem 0;
  }

  .post-cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .post-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1rem;
    border: 1px solid rgb(var(--surface-divider));
    border-radius: 8px;
    background: rgb(var(--surface-elevated));
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, background 0.15s;
  }

  .post-card:hover {
    border-color: rgb(var(--gray));
    background: rgb(var(--gray-light), 0.3);
    color: inherit;
  }

  .post-card-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .post-card-title {
    font-weight: 700;
    font-size: 0.95em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .post-card-date {
    font-size: 0.78em;
    color: rgb(var(--text-muted));
  }

  .post-card-excerpt {
    margin: 0;
    font-size: 0.82em;
    color: rgb(var(--text-muted));
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .post-card-arrow {
    flex-shrink: 0;
    font-size: 1.1em;
    color: rgb(var(--text-muted));
    transition: transform 0.15s, color 0.15s;
  }

  .post-card:hover .post-card-arrow {
    transform: translateX(3px);
    color: rgb(var(--gray));
  }
</style>
