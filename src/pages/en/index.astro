---
import { SITE_DESCRIPTION_EN } from "../../consts";
import BlogPost from "../../components/BlogPost.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { getCollection, render } from "astro:content";

const FULL_POSTS = 5;
const posts = await getCollection("blogEn");
const visiblePosts = posts.filter((post) => !post.data.draft);
const fullPosts = visiblePosts.slice(0, FULL_POSTS);
const previewPosts = visiblePosts.slice(FULL_POSTS);
---

<BaseLayout description={SITE_DESCRIPTION_EN} locale="en">
  {
    fullPosts.map(async (post, index) => {
      const { Content } = await render(post);
      return (
        <>
          <BlogPost {...post.data}>
            <Content />
          </BlogPost>
          {index < fullPosts.length - 1 && <hr class="blog-divider" />}
        </>
      );
    })
  }

  {
    previewPosts.length > 0 && (
      <>
        <hr class="blog-divider" />
        <ul class="post-previews">
          {previewPosts.map((post) => (
            <li>
              <a href={`/en/blog/${post.id}`}>{post.data.title}</a>
              <span class="preview-date">
                <FormattedDate date={post.data.pubDate} locale="en" />
              </span>
              {post.data.description && (
                <p class="preview-desc">{post.data.description}</p>
              )}
            </li>
          ))}
        </ul>
      </>
    )
  }
</BaseLayout>

<style>
  .blog-divider {
    border-top-color: rgb(var(--surface-divider));
    margin: 4rem 0;
  }

  .post-previews {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .post-previews li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .post-previews a {
    font-weight: 500;
  }

  .preview-date {
    font-size: 0.85em;
    color: rgb(var(--gray));
  }

  .preview-desc {
    margin: 0;
    color: rgb(var(--text-muted));
    font-size: 0.92em;
  }
</style>
