---
import type { GetStaticPaths } from "astro";
import { SITE_DESCRIPTION_EN, SITE_TITLE } from "../../../consts";
import BlogPost from "../../../components/BlogPost.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getAllPosts, type GhostPost } from "../../../lib/ghost";

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getAllPosts('en');
  return posts
    .filter((post) => post.featured)
    .map((post) => ({
      params: { slug: post.slug },
      props: { post },
    }));
};

const { post } = Astro.props as { post: GhostPost };

const canonicalPath = `/en/featured/${Astro.params.slug}`;
const seoTitle = post.meta_title ?? `${post.title} | ${SITE_TITLE}`;
const seoDescription = post.meta_description ?? post.custom_excerpt ?? post.excerpt ?? SITE_DESCRIPTION_EN;

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  datePublished: post.published_at,
  mainEntityOfPage: new URL(canonicalPath, Astro.site).toString(),
  description: seoDescription,
});
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  locale="en"
  canonicalPath={canonicalPath}
  metaType="article"
  publishedTime={post.published_at}
>
  <BlogPost pubDate={post.published_at} title={post.title} featureImage={post.feature_image} featureImageAlt={post.feature_image_alt}>
    <Fragment set:html={post.html} />
  </BlogPost>

  <p><a href="/en">← Back to the blog</a></p>

  <script type="application/ld+json" set:html={jsonLd} />
</BaseLayout>
