---
import { getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReviewGrid from "../../components/ReviewGrid.astro";
import Navbar from "../../components/Navbar.astro";
import { getReviewNavLinks } from "../../i18n";

const entry = await getEntry("reviews", "ol");

if (!entry) {
  throw new Error("Missing review entry: reviews/ol.md");
}

const { Content } = await render(entry);
---

<BaseLayout
  description={entry.data.description ?? `Reviews: ${entry.data.title}`}
  locale="en"
>
  <div class="review-subnav">
    <Navbar links={getReviewNavLinks("en")} locale="en" ariaLabel="Reviews navigation" />
  </div>

  <section class="prose">
    <Content />
  </section>

  <ReviewGrid items={entry.data.items} emptyText="No beers yet." />
</BaseLayout>

<style>
  .review-subnav {
    margin-top: -0.7rem;
    margin-bottom: 0.6rem;
  }

  .review-subnav :global(.navbar-inner) {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding-top: 0.35rem;
    padding-bottom: 0.35rem;
  }
</style>
