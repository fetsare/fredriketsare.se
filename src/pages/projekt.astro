---
import BaseLayout from "../layouts/BaseLayout.astro";
import me from "../assets/me.webp";
import doalot from "../assets/doalot-se.webp";
import num2kana from "../assets/num2kana.mp4";
import kiosk from "../assets/kiosk.webp";
import svd from "../assets/systemvetardagen-se.webp";
import ak from "../assets/www-akademiskkvart-se.webp";
import ff from "../assets/foreverflashback.webp";

type MediaSource = { src: string } | string;

type ProjectBase = {
  title: string;
  description: string;
  href?: string;
};

type ProjectWithImage = ProjectBase & {
  image: MediaSource;
  video?: never;
};

type ProjectWithVideo = ProjectBase & {
  video: MediaSource;
  image?: never;
};

type Project = ProjectWithImage | ProjectWithVideo;

const escapeHtml = (value: string) =>
  value
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#39;");

const isAllowedHref = (href: string) => {
  if (href.startsWith("/")) return true;

  try {
    const { protocol } = new URL(href);
    return (
      protocol === "http:" || protocol === "https:" || protocol === "mailto:"
    );
  } catch {
    return false;
  }
};

const renderDescription = (text: string) => {
  const escapedText = escapeHtml(text);

  return escapedText.replace(
    /\[([^\]]+)\]\(([^)]+)\)/g,
    (_match, label, href) => {
      const cleanHref = String(href).trim();
      if (!isAllowedHref(cleanHref)) return label;

      return `<a href="${escapeHtml(cleanHref)}" target="_blank" rel="noopener noreferrer">${label}</a>`;
    },
  );
};

const getMediaSrc = (media: MediaSource) =>
  typeof media === "string" ? media : media.src;

const hasVideo = (project: Project): project is ProjectWithVideo =>
  project.video !== undefined;

const projects: Project[] = [
  {
    title: "Forever Flashback",
    description:
      "En hyllning till min favoritpodd [Flashback Forever](https://flashbackforever.se), byggd för att visa lite tacksamhet mot skaparna. Ljudet klipps och normaliseras med [ffmpeg](https://ffmpeg.org/), transkriberas med [KBLab:s Whisper-modell](https://huggingface.co/KBLab/kb-whisper-large) och körs sedan genom [KBLab:s NER-modell](https://huggingface.co/KBLab/bert-base-swedish-cased-ner) för att hitta namn, platser och andra omnämnanden i varje avsnitt. Texten används sedan för att bygga ett sökindex med Postgres inbyggda [full text search](https://www.postgresql.org/docs/current/textsearch.html), tillsammans med statistik som omnämnanden, volymnivåer och annat kul jag kunde gräva fram.",
    image: ff,
    href: "https://foreverflashback.se",
  },
  {
    title: "akademiskkvart.se",
    description:
      "IT-projektledare för vidareutvecklingen av Akademisk kvart, en andrahandsplattform för studentbostäder. Jag ansvarar för hela projektet: hela AWS stacken, frontend, SEO och design. Arbetet sker under [SSCO](https://ssco.se/).",
    image: ak,
    href: "https://www.akademiskkvart.se",
  },
  {
    title: "foobar depart",
    description:
      "En tidtabell för bussar, tåg och tunnelbana från Kista. Jag installerade den i studentpuben [Foo Bar](https://maps.app.goo.gl/z1dmB1u3RpFBVK2d6) för att aldrig missa tuben igen. Byggd med data från [Trafiklab](https://www.trafiklab.se/) och deras API [ResRobot V2](https://www.trafiklab.se/api/our-apis/resrobot-v21/).",
    image: kiosk,
    href: "https://depart.fredriketsare.se",
  },
  {
    title: "Systemvetardagen",
    description:
      "Systemvetardagen är en arbetsmässa för IT-studenter som arrangeras av [Studentkåren DISK](https://www.disk.su.se/). Jag har jobbat med mässan i tre år och har framför allt drivit och utvecklat hemsidan.",
    image: svd,
    href: "https://systemvetardagen.se",
  },
  {
    title: "num2kana",
    description:
      "Ett npm paket för att översätta siffror till dess japanska skrivformer. Jag skapade detta mest för att lära mig japanska siffror/räkneord men samtidigt npm-ekosystemet. Här är själva [npm paketet](https://www.npmjs.com/package/num2kana)",
    video: num2kana,
    href: "https://num2kana.fredriketsare.se",
  },
  {
    title: "doalot.se",
    description: "En portfölj sida för [Doalot AB](https://doalot.se)",
    image: doalot,
    href: "https://doalot.se",
  },
  {
    title: "fredriketsare.se",
    description:
      "Denna sida är byggd på [Astro](https://astro.build/) och hostas på [cloudflare pages](https://pages.cloudflare.com/). Här kan du läsa om mig och mina projekt, kul att du kom hit, om du vill skapa en liknande sida hittar du git repot [här](https://github.com/fetsare/fredriketsare.se). Alla hemsidabilder togs med [click.grj.se](https://click.grj.se) av [Gunnar R Johansson](https://gunnar.se)",
    image: me,
    href: "https://fredriketsare.se",
  },
];
---

<BaseLayout description="Projekt av Fredrik Etsare." wide>
  <section>
    {
      projects.map((project, index) => (
        <article>
          {hasVideo(project) ? (
            <video
              class="project-media"
              autoplay
              loop
              muted
              playsinline
              preload="metadata"
            >
              <source src={getMediaSrc(project.video)} />
              Din webbläsare stödjer inte videouppspelning.
            </video>
          ) : (
            <img
              class="project-media"
              src={getMediaSrc(project.image)}
              alt={project.title}
              loading="lazy"
            />
          )}

          <h4>
            {project.href ? (
              <a href={project.href} target="_blank" rel="noopener noreferrer">
                {project.title}
              </a>
            ) : (
              project.title
            )}
          </h4>

          <p set:html={renderDescription(project.description)} />

          {index < projects.length - 1 && <hr class="project-divider" />}
        </article>
      ))
    }
  </section>
</BaseLayout>

<style>
  article {
    margin-bottom: 1.75rem;
  }

  .project-media {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 0.75rem;
  }

  article h4,
  article p {
    margin: 0;
  }

  article h4 {
    margin-bottom: 0.75rem;
  }

  .project-divider {
    border-top-color: rgb(var(--surface-divider));
    margin: 4rem 0;
  }

  @media (min-width: 721px) {
    section {
      column-count: 2;
      column-gap: 3rem;
      column-rule: 1px solid rgb(var(--surface-divider));
    }

    article {
      break-inside: avoid;
    }

    .project-divider {
      break-after: avoid;
      break-before: avoid;
    }
  }
</style>
