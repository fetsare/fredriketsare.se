---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ReviewGrid from "../components/ReviewGrid.astro";
import Navbar from "../components/Navbar.astro";
import { REVIEW_NAV_LINKS } from "../consts";

const entry = await getEntry("reviews", "kyrkor");

if (!entry) {
	throw new Error("Missing review entry: reviews/kyrkor.md");
}

const { Content } = await render(entry);
---

<BaseLayout
	description={entry.data.description ?? `Recensioner: ${entry.data.title}`}
>
	<div class="review-subnav">
		<Navbar links={REVIEW_NAV_LINKS} ariaLabel="Recensioner navigation" />
	</div>

	<section class="prose">
		<Content />
	</section>

	<ReviewGrid items={entry.data.items} />
</BaseLayout>

<style>
	.review-subnav {
		margin-top: -0.7rem;
		margin-bottom: 0.6rem;
	}

	.review-subnav :global(.navbar-inner) {
		width: 100%;
		max-width: 100%;
		margin: 0;
		padding-top: 0.35rem;
		padding-bottom: 0.35rem;
	}
</style>
