---
import { SITE_DESCRIPTION } from "../consts";
import BlogPost from "../components/BlogPost.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import BooksColumnList from "../components/BooksColumnList.astro";
import FormattedDate from "../components/FormattedDate.astro";
import NowPlaying from "../components/NowPlaying.astro";
import GithubActivity from "../components/GithubActivity.astro";
import { getEntry } from "astro:content";
import { getAllPosts, getLatestGallery } from "../lib/ghost";
import PhotoGallery from "../components/PhotoGallery.astro";

const RECENT_BOOKS_COUNT = 30;
const [posts, gallery] = await Promise.all([getAllPosts('sv'), getLatestGallery()]);
const fullPosts = posts.slice(0, 1);
const previewPosts = posts.slice(1, 4);

const booksEntry = await getEntry("books", "books");
const recentBooks = booksEntry ? booksEntry.data.items.slice(-RECENT_BOOKS_COUNT).reverse() : [];
---

<BaseLayout description={SITE_DESCRIPTION}>
  {
    fullPosts.map((post, index) => (
      <>
        <BlogPost
          pubDate={post.published_at}
          title={post.title}
          featureImage={post.feature_image}
          featureImageAlt={post.feature_image_alt}
        >
          <Fragment set:html={post.html} />
        </BlogPost>
        {index < fullPosts.length - 1 && <hr class="blog-divider" />}
      </>
    ))
  }

  {
    previewPosts.length > 0 && (
      <>
        <hr class="blog-divider" />
        <ul class="post-list">
          {previewPosts.map((post) => (
            <li>
              <a
                href={post.url}
                class="post-list-item"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="post-list-title">{post.title}</span>
                <span class="post-list-date">
                  <FormattedDate date={new Date(post.published_at)} locale="sv" />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </>
    )
  }

  {previewPosts.length > 0 && (
    <a
      href="https://blog.fredriketsare.se"
      target="_blank"
      rel="noopener noreferrer"
      class="see-all-posts"
    >
      Se alla inlägg →
    </a>
  )}

  {gallery && (
    <>
      <hr class="blog-divider" />
      <PhotoGallery images={gallery.images} href={gallery.url} />
    </>
  )}

  {
    recentBooks.length > 0 && (
      <Fragment slot="books-column">
        <NowPlaying />
        <GithubActivity />
        <BooksColumnList items={recentBooks} locale="sv" seeAllHref="/books" />
      </Fragment>
    )
  }
</BaseLayout>

<style>
  .blog-divider {
    border-top-color: rgb(var(--surface-divider));
    margin: 2rem 0;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .post-list-item {
    display: block;
    padding: 0.4rem 0;
    text-decoration: none;
    color: inherit;
  }

  .post-list-title {
    display: block;
    font-size: 1.15em;
    font-weight: 700;
    line-height: 1.25;
    margin-bottom: 0.15em;
  }

  .post-list-item:hover .post-list-title {
    text-decoration: underline;
  }

  .post-list-date {
    display: block;
    font-size: 0.78em;
    color: rgb(var(--text-muted));
  }

  .see-all-posts {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.85em;
    color: rgb(var(--gray));
    text-decoration: none;
  }

  .see-all-posts:hover {
    color: rgb(var(--text-primary));
    text-decoration: underline;
  }
</style>
