---
import type { GetStaticPaths } from "astro";
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReviewGrid from "../../components/ReviewGrid.astro";
import Navbar from "../../components/Navbar.astro";
import { REVIEW_NAV_LINKS } from "../../consts";

export const getStaticPaths: GetStaticPaths = async () => {
  const pages = await getCollection("reviews");
  return pages.map((page) => ({ params: { slug: page.id } }));
};

const { slug } = Astro.params;

if (!slug) {
  throw new Error("Missing image category slug.");
}

const entry = await getEntry("reviews", slug);

if (!entry) {
  throw new Error(`Missing image category entry: reviews/${slug}.md`);
}

const { Content } = await render(entry);
---

<BaseLayout
  description={entry.data.description ?? `Bilder: ${entry.data.title}`}
>
  <div class="review-subnav">
    <Navbar links={REVIEW_NAV_LINKS} ariaLabel="Bilder navigation" />
  </div>
  <section class="prose">
    <Content />
  </section>

  <ReviewGrid items={entry.data.items} emptyText={`Inga bilder i ${entry.data.title} ännu.`} />
</BaseLayout>

<style>
  .review-subnav {
    margin-top: -0.7rem;
    margin-bottom: 0.6rem;
  }

  .review-subnav :global(.navbar-inner) {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding-top: 0.35rem;
    padding-bottom: 0.35rem;
  }
</style>
