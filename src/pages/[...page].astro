---
import type { GetStaticPaths } from "astro";
import { SITE_DESCRIPTION } from "../consts";
import BlogPost from "../components/BlogPost.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import BooksColumnList from "../components/BooksColumnList.astro";
import { getEntry } from "astro:content";
import { getAllPosts, type GhostPost } from "../lib/ghost";

type PaginatedBlogPage = {
  data: GhostPost[];
  url: {
    prev?: string;
    next?: string;
  };
};

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const POSTS_PER_PAGE = 5;
  const posts = await getAllPosts('sv');
  return paginate(posts, { pageSize: POSTS_PER_PAGE }).filter(
    (entry) => Boolean(entry.params.page),
  );
};

const { page } = Astro.props as { page: PaginatedBlogPage };

const RECENT_BOOKS_COUNT = 30;
const booksEntry = await getEntry("books", "books");
const recentBooks = booksEntry ? booksEntry.data.items.slice(-RECENT_BOOKS_COUNT).reverse() : [];
---

<BaseLayout description={SITE_DESCRIPTION}>
  {
    page.data.map((post, index) => (
      <>
        <BlogPost pubDate={post.published_at} title={post.title} featureImage={post.feature_image} featureImageAlt={post.feature_image_alt}>
          <Fragment set:html={post.html} />
        </BlogPost>
        {index < page.data.length - 1 && <hr class="blog-divider" />}
      </>
    ))
  }

  <nav class="pagination" aria-label="Blog pagination">
    {page.url.prev && (
      <a href={page.url.prev} rel="prev">← Newer posts</a>
    )}
    {page.url.next && (
      <a href={page.url.next} rel="next">Older posts →</a>
    )}
  </nav>

  {
    recentBooks.length > 0 && (
      <Fragment slot="books-column">
        <BooksColumnList items={recentBooks} locale="sv" seeAllHref="/books" />
      </Fragment>
    )
  }
</BaseLayout>

<style>
  .blog-divider {
    border-top-color: rgb(var(--surface-divider));
    margin: 4rem 0;
  }

  .pagination {
    margin-top: 3rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
</style>
