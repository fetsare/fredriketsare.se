---
import BaseLayout from "../layouts/BaseLayout.astro";
import MigContent from "../content/mig.md";
import SocialLinks from "../components/SocialLinks.astro";
---

<BaseLayout description="Om Fredrik Etsare.">
  <section class="mig-content">
    <MigContent />
  </section>

  <div class="mig-links">
    <div class="social-links">
      <SocialLinks />
    </div>
  </div>
</BaseLayout>

<style>
  .mig-content :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 0.75rem;
  }

  .mig-content :global(p) {
    margin: 0 0 0.9rem;
  }

  .mig-content :global(p:last-of-type) {
    margin-bottom: 0;
  }

  .mig-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(var(--surface-divider));
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
</style>
